generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = "postgresql://neondb_owner:npg_Jkrcad1RtT3K@ep-shiny-wildflower-adaz8eto-pooler.c-2.us-east-1.aws.neon.tech/neondb?sslmode=require"
  directUrl = "postgresql://neondb_owner:npg_Jkrcad1RtT3K@ep-shiny-wildflower-adaz8eto.c-2.us-east-1.aws.neon.tech/neondb?sslmode=require"
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model User {
  id                       String               @id @default(cuid())
  name                     String?
  email                    String               @unique
  emailVerified            DateTime?
  image                    String?
  password                 String?
  firstName                String?
  lastName                 String?
  institutionName          String?
  userType                 String?
  researchArea             String?
  academicLevel            String?
  phoneNumber              String?
  linkedinUrl              String?
  twitterUrl               String?
  websiteUrl               String?
  isActive                 Boolean              @default(false)
  verificationToken        String?
  verificationTokenExpires DateTime?
  createdAt                DateTime             @default(now())
  updatedAt                DateTime             @updatedAt
  accounts                 Account[]
  comments                 Comment[]            @relation("CommentAuthor")
  receivedInvites          Invite[]             @relation("ReceivedInvites")
  sentInvites              Invite[]             @relation("SentInvites")
  generatedInviteCodes     InviteCode[]         @relation("GeneratedInviteCodes")
  usedInviteCodes          InviteCode[]         @relation("UsedInviteCodes")
  mentorProfile            MentorProfile?
  mentorProjects           MentorProject[]      @relation("MentorProjects")
  studentProjects          MentorProject[]      @relation("StudentProjects")
  receivedMessages         Message[]            @relation("ReceivedMessages")
  sentMessages             Message[]            @relation("SentMessages")
  sessions                 Session[]
  timelines                Timeline[]
  mentorAccess             WritingSpaceAccess[] @relation("MentorAccess")
  studentAccess            WritingSpaceAccess[] @relation("StudentAccess")
}

model MentorProfile {
  id                String   @id @default(cuid())
  userId            String   @unique
  bio               String?
  expertise         String?
  hourlyRate        Float?
  availability      String?
  responseTime      String?
  languages         String?
  timezone          String?
  education         String?
  publications      String?
  specializations   String?
  socialLinks       String?
  completedProjects Int      @default(0)
  rating            Float    @default(0.0)
  reviewCount       Int      @default(0)
  isVerified        Boolean  @default(false)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Timeline {
  id                 String               @id @default(cuid())
  title              String
  documentType       String
  startDate          DateTime?
  completionDate     DateTime?
  academicLevel      String?
  discipline         String?
  researchTopic      String?
  wordCount          Int                  @default(2000)
  userId             String?
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt
  comments           Comment[]
  invites            Invite[]
  mentorProjects     MentorProject[]
  sections           Section[]
  user               User?                @relation(fields: [userId], references: [id], onDelete: Cascade)
  writingSpaceAccess WritingSpaceAccess[]
}

model Section {
  id          String   @id @default(cuid())
  title       String
  content     String?
  duration    Int?
  isCompleted Boolean  @default(false)
  timelineId  String
  order       Int?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  timeline    Timeline @relation(fields: [timelineId], references: [id], onDelete: Cascade)
}

model Message {
  id         String   @id @default(cuid())
  senderId   String
  receiverId String
  subject    String?
  body       String
  status     String   @default("unread")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  receiver   User     @relation("ReceivedMessages", fields: [receiverId], references: [id], onDelete: Cascade)
  sender     User     @relation("SentMessages", fields: [senderId], references: [id], onDelete: Cascade)
}

model InviteCode {
  id        String    @id @default(cuid())
  code      String    @unique
  mentorId  String
  studentId String?
  isUsed    Boolean   @default(false)
  expiresAt DateTime?
  createdAt DateTime  @default(now())
  usedAt    DateTime?
  invites   Invite[]
  mentor    User      @relation("GeneratedInviteCodes", fields: [mentorId], references: [id], onDelete: Cascade)
  student   User?     @relation("UsedInviteCodes", fields: [studentId], references: [id])
}

model WritingSpaceAccess {
  id         String    @id @default(cuid())
  timelineId String
  mentorId   String
  studentId  String
  accessType String    @default("READ")
  grantedAt  DateTime  @default(now())
  expiresAt  DateTime?
  mentor     User      @relation("MentorAccess", fields: [mentorId], references: [id], onDelete: Cascade)
  student    User      @relation("StudentAccess", fields: [studentId], references: [id], onDelete: Cascade)
  timeline   Timeline  @relation(fields: [timelineId], references: [id], onDelete: Cascade)

  @@unique([timelineId, mentorId])
}

model MentorProject {
  id          String    @id @default(cuid())
  projectId   String
  mentorId    String
  studentId   String
  role        String    @default("pending")
  invitedAt   DateTime  @default(now())
  respondedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  mentor      User      @relation("MentorProjects", fields: [mentorId], references: [id], onDelete: Cascade)
  project     Timeline  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  student     User      @relation("StudentProjects", fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([projectId, mentorId])
}

model Invite {
  id           String     @id @default(cuid())
  inviteCodeId String
  projectId    String
  mentorId     String
  studentId    String
  status       String     @default("pending")
  emailSent    Boolean    @default(false)
  emailSentAt  DateTime?
  respondedAt  DateTime?
  expiresAt    DateTime
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  inviteCode   InviteCode @relation(fields: [inviteCodeId], references: [id], onDelete: Cascade)
  mentor       User       @relation("ReceivedInvites", fields: [mentorId], references: [id], onDelete: Cascade)
  project      Timeline   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  student      User       @relation("SentInvites", fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([projectId, mentorId, inviteCodeId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Comment {
  id         String   @id @default(cuid())
  content    String
  timelineId String
  sectionId  String?
  authorId   String
  isEdited   Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  author     User     @relation("CommentAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  timeline   Timeline @relation(fields: [timelineId], references: [id], onDelete: Cascade)
}
